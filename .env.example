# Everything here is optional. Without any of it the app runs in fixture mode,
# and live mode looks for a local model through Ollama.

# Which model service the two live steps use: "ollama" (local) or "anthropic" (Claude).
# Default: anthropic if ANTHROPIC_API_KEY is set, otherwise ollama.
TRAILCHECK_PROVIDER=

# Local model (Ollama)
OLLAMA_MODEL=gemma3:4b
OLLAMA_HOST=http://localhost:11434

# Claude
ANTHROPIC_API_KEY=
TRAILCHECK_MODEL=claude-opus-5-5

PORT=5173
